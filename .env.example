DATABASE_URL=postgresql+asyncpg://service_user:service_pass@localhost:5432/service_db
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
POSTGRES_PASSWORD=change-me-to-a-database-password
PUBLIC_APP_URL=https://service.example.com
# Comma-separated browser origins and Host headers accepted by FastAPI.
ALLOWED_ORIGINS=https://service.example.com
ALLOWED_HOSTS=service.example.com,localhost,127.0.0.1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@service.example.com
# Password reset: production delivery uses SMTP. Keep debug false outside local development.
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_DEBUG=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# AI preview: server opt-in only after migration and organization UUID verification.
# Budget values are local token-price estimates, never the Yandex Cloud balance.
AI_ENABLED=false
AI_REPAIR_ENABLED=false
AI_BRIEF_ENABLED=false
AI_ORGANIZATION_IDS=
# Optional client UUID allowlist inside the permitted service organizations.
AI_CLIENT_IDS=
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
AI_MODEL=yandexgpt-5.1
AI_TIMEOUT_SECONDS=30
AI_MONTHLY_LIMIT_RUB=300
AI_DAILY_LIMIT_RUB=10
AI_INPUT_RUB_PER_1000=0.8
AI_OUTPUT_RUB_PER_1000=0.8
AI_PRIOR_ACCOUNTED_RUB=6.3992
AI_PRIOR_ACCOUNTED_DATE=2026-10-19
