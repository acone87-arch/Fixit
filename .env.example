DATABASE_URL=postgresql+asyncpg://service_user:service_pass@localhost:5432/service_db
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
POSTGRES_PASSWORD=change-me-to-a-database-password
PUBLIC_APP_URL=https://service.example.com
# Comma-separated browser origins and Host headers accepted by FastAPI.
ALLOWED_ORIGINS=https://service.example.com
ALLOWED_HOSTS=service.example.com,localhost,127.0.0.1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@service.example.com
